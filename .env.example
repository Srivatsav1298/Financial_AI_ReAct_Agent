# Norfain ReAct Agent - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5050

# Secret key for session security (generate a random one)
SECRET_KEY=change-me-in-production-to-a-random-secret-key-please

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
CACHE_ENABLED=true
CACHE_TYPE=redis  # Options: simple (memory), redis
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_TIMEOUT=3600
CACHE_KEY_PREFIX=norfain:
CACHE_MAX_SIZE=1000

# SSB specific cache TTL (24 hours)
SSB_CACHE_TTL=86400

# ============================================================================
# RATE LIMITING
# ============================================================================
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_ASK=30 per minute
RATELIMIT_SSB=60 per minute

# For Redis-backed distributed rate limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
AGENT_MODEL=llama3.2:latest
DEFAULT_AGENT=react

# ============================================================================
# SSB API CONFIGURATION
# ============================================================================
SSB_API_BASE_URL=https://data.ssb.no/api/v0

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================================================
# ADMIN CONFIGURATION (for production)
# ============================================================================
ADMIN_TOKEN=your-secure-admin-token-here

# ============================================================================
# MONITORING & TRACING (optional)
# ============================================================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# OpenTelemetry endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
