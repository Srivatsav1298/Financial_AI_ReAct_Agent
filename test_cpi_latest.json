{"version":"2.0","class":"dataset","label":"03013: Consumer Price Index, by consumption group, contents and month","source":"Statistics Norway","updated":"2025-12-10T07:00:00Z","note":["As of 2017 the reference year is 2015=100. Rates of change calculated from the 2015=100 series may differ from previously published rates of change where reference year differs. The deviations are mainly due to rounding effects. See the completed time series 11446 for published rates of change figures through 2016 with 1998=100. \n\n<br><br>As of January 2016, EUROSTAT's consumer classification (ECOICOP) is applied - an extended classification at the detailed level.","The following price indices for services are based on estimated values due to non-availability during the COVID-19 pandemic 2020M04: 06.2.2, 07.3.3, 09.4.2, 09.6.0, 11.2.0, 12.1.1, 12.4.0., 2020M05: 06.2.2, 07.3.3, 09.4.2, 09.6.0, 11.2.0, 2020M06-2020M12: 07.3.3.2, 09.6.0, 2021M01-M05: 07.3.3, 07.3.4, 09.6.0, 2021M06-M07: 07.3.3.2, 07.3.4, 09.6.0, 2021M08: 07.3.3.2, 09.6.0","Corrected figures for October 2025 for TOTAL All-item index and the 3 lower aggregates: 'Housing, water electricity, gas and other fuels', 'Electricity, gas and other fuels' in addition to 'Electricity including grid rent' (published 13.11.2025)."],"role":{"time":["Tid"],"metric":["ContentsCode"]},"id":["Konsumgrp","ContentsCode","Tid"],"size":[1,4,1],"dimension":{"Konsumgrp":{"label":"consumption group","category":{"index":{"TOTAL":0},"label":{"TOTAL":"All-item index"}},"extension":{"elimination":true,"eliminationValueCode":"TOTAL","show":"code_value"},"link":{"describedby":[{"extension":{"Konsumgrp":"urn:ssb:classification:klass:134"}}]}},"ContentsCode":{"label":"contents","category":{"index":{"KpiIndMnd":0,"Manedsendring":1,"Tolvmanedersendring":2,"KpiVektMnd":3},"label":{"KpiIndMnd":"Consumer Price Index (2015=100)","Manedsendring":"Monthly change (per cent)","Tolvmanedersendring":"12-month rate (per cent)","KpiVektMnd":"Consumer Price Index (weights)"},"note":{"KpiVektMnd":["The weights does not always sum to 1000.0 due to rounding effects. As of January 2011, the CPI weights are based on the National Accounts. The weights up to July 1999 were based on an old consumer classification, as of August 1999 COICOP was introduced as a new international classification. The weights after old classification were regrouped, hence no direct comparison can be made for weights between the period 1979-July 1999 and as of August 1999."]},"unit":{"KpiIndMnd":{"base":"index","decimals":1},"Manedsendring":{"base":"per cent","decimals":1},"Tolvmanedersendring":{"base":"per cent","decimals":1},"KpiVektMnd":{"base":"weights","decimals":1}}},"extension":{"elimination":false,"refperiod":{"KpiIndMnd":"Month","Manedsendring":"Month","Tolvmanedersendring":"Month","KpiVektMnd":"Applies to calendar year"},"show":"value","measuringType":{"KpiIndMnd":"Average","Manedsendring":"Average","Tolvmanedersendring":"Average","KpiVektMnd":"Average"},"priceType":{"KpiIndMnd":"NotApplicable","Manedsendring":"NotApplicable","Tolvmanedersendring":"NotApplicable","KpiVektMnd":"NotApplicable"},"adjustment":{"KpiIndMnd":"None","Manedsendring":"None","Tolvmanedersendring":"None","KpiVektMnd":"None"},"basePeriod":{"KpiIndMnd":"2015"}},"link":{"describedby":[{"extension":{"KpiIndMnd":"urn:ssb:conceptvariable:vardok:2755","KpiVektMnd":"urn:ssb:conceptvariable:vardok:2756"}}]}},"Tid":{"label":"month","category":{"index":{"2025M11":0},"label":{"2025M11":"2025M11"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"noteMandatory":{"2":true},"px":{"infofile":"None","tableid":"03013","decimals":1,"official-statistics":true,"aggregallowed":false,"copyright":false,"language":"en","contents":"03013: Consumer Price Index,","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":["Konsumgrp"],"matrix":"KpiIndMnd","subject-code":"pp","subject-area":"Prices and price indices"},"discontinued":null,"contact":[{"name":"Konsumprisindeksen","organ